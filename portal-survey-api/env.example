# portal-survey-api — Local Development
APP_NAME=portal-survey-api
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# MySQL (in-cluster pod)
DB_HOST=portal-survey-mysql
DB_PORT=3306
DB_NAME=portal_survey_db
DB_USER=appadmin
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# JWT
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
