AGENT_ENV=development
API_BASE_URL=http://localhost:8000
MCP_SERVER_URL=http://localhost:8002/sse
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ALLOWED_ORIGINS=*

# MCP vs REST API toggle
# Set to true to use MCP server (requires SSE transport on port 8002)
# Set to false to use REST API (default, recommended)
USE_MCP_TOOLS=false
